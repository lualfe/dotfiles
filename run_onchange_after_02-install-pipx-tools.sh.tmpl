#!/bin/bash

SEP="=================================================="
echo "$SEP"
echo ">>> INICIO: 02-install-pipx-tools"
echo "$SEP"

# Garante que o pipx esteja no PATH para este script (Mac/Linux)
if [[ -d /opt/homebrew/bin ]]; then
    export PATH="/opt/homebrew/bin:$PATH"
fi
export PATH="$HOME/.local/bin:$PATH"

# Hash para detectar mudanças na lista:
# {{ list "sqlfluff" "tmuxp" "posting" | join " " }}

packages=(
  "sqlfluff"
  "tmuxp"
  "posting"
)

echo "Instalando/Atualizando ferramentas Python via pipx..."

# ~/.local/bin já é exportado no PATH via dot_zshrc (não usar `pipx
# ensurepath`: ele mexe direto no ~/.zshrc no disco, e o chezmoi
# sobrescreve esse arquivo a partir do source a cada apply, perdendo
# a alteração depois da primeira execução).

echo "$SEP"
# Uma instalação pipx interrompida (rede, VM derrubada no meio, etc)
# deixa um venv com pipx_metadata.json vazio/inválido. Isso quebra
# `pipx list` para TODOS os pacotes (não só o corrompido), então
# qualquer verificação baseada em `pipx list` trava para sempre.
# Limpa venvs corrompidos antes de mexer em qualquer coisa.
PIPX_VENVS_DIR=$(pipx environment --value PIPX_LOCAL_VENVS 2>/dev/null || echo "$HOME/.local/share/pipx/venvs")
if [[ -d "$PIPX_VENVS_DIR" ]]; then
  for venv in "$PIPX_VENVS_DIR"/*/; do
    [[ -d "$venv" ]] || continue
    meta="${venv}pipx_metadata.json"
    if ! python3 -c "import json,sys; json.load(open(sys.argv[1]))" "$meta" &> /dev/null; then
      echo "Removendo venv pipx corrompido: $(basename "$venv")"
      rm -rf "$venv"
    fi
  done
fi

# --force em vez de list+grep+upgrade/install: não depende do `pipx
# list` (frágil, como visto acima) e se auto-corrige sozinho caso o
# venv de um pacote específico esteja corrompido.
for pkg in "${packages[@]}"; do
  echo "$SEP"
  echo "Instalando/atualizando $pkg..."
  pipx install --force "$pkg"
done

echo "$SEP"
echo ">>> FIM: 02-install-pipx-tools"
echo "$SEP"
