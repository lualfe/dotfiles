#!/bin/bash

# Garante que o pipx esteja no PATH para este script (Mac/Linux)
if [[ -d /opt/homebrew/bin ]]; then
    export PATH="/opt/homebrew/bin:$PATH"
fi
export PATH="$HOME/.local/bin:$PATH"

# Hash para detectar mudanças na lista: 
# {{ list "sqlfluff" "tmuxp" "posting" | join " " }}

packages=(
  "sqlfluff"
  "tmuxp"
  "posting"
)

echo "Instalando/Atualizando ferramentas Python via pipx..."

# ~/.local/bin já é exportado no PATH via dot_zshrc (não usar `pipx
# ensurepath`: ele mexe direto no ~/.zshrc no disco, e o chezmoi
# sobrescreve esse arquivo a partir do source a cada apply, perdendo
# a alteração depois da primeira execução).

for pkg in "${packages[@]}"; do
  if pipx list | grep -q "$pkg"; then
    echo "Atualizando $pkg..."
    pipx upgrade "$pkg"
  else
    echo "Instalando $pkg..."
    pipx install "$pkg"
  fi
done

