#!/bin/bash

echo ">>> INICIO: 03-install-zsh-plugins"

echo "DEBUG usuário: $(id -un)"
echo "DEBUG HOME: $HOME"

if [ ! -d "$HOME/.oh-my-zsh" ]; then
  echo "Instalando Oh My Zsh..."
  CHSH=no RUNZSH=no KEEP_ZSHRC=yes sh -c "$(curl -fsSL https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh)" "" --unattended
  echo ""
fi

ZSH_CUSTOM=${ZSH_CUSTOM:-$HOME/.oh-my-zsh/custom}
echo "DEBUG ZSH_CUSTOM resolvido: $ZSH_CUSTOM"
mkdir -p "$ZSH_CUSTOM/plugins"
mkdir -p "$ZSH_CUSTOM/themes"

# 1. Tema Powerlevel10k — reinstala do zero sempre, sem checar se já
# existe (script já roda em todo `chezmoi apply`, então o custo é só
# um git clone a mais, e isso elimina qualquer chance de ficar com
# um clone incompleto/corrompido travado para sempre).
echo "Instalando Powerlevel10k..."
rm -rf "$ZSH_CUSTOM/themes/powerlevel10k"
git clone --depth=1 https://github.com/romkatv/powerlevel10k.git "$ZSH_CUSTOM/themes/powerlevel10k"
echo ""

# Lista de plugins extras para clonar
plugins=(
  "zsh-users/zsh-autosuggestions"
  "zsh-users/zsh-syntax-highlighting"
)

for plugin in "${plugins[@]}"; do
  plugin_name=$(basename $plugin)
  plugin_dir="$ZSH_CUSTOM/plugins/$plugin_name"
  echo "Instalando plugin $plugin_name..."
  rm -rf "$plugin_dir"
  git clone "https://github.com/$plugin" "$plugin_dir"
  echo ""
done

# CHSH=no acima pula a troca de shell padrão; no Linux o zsh não vem
# como shell padrão (diferente do macOS), então define explicitamente.
# Obs: só vale a partir do próximo login (logout/login ou reboot),
# não numa nova aba/janela de terminal dentro da mesma sessão.
if [[ "$(uname -s)" == "Linux" ]]; then
  CURRENT_USER=$(id -un)
  CURRENT_SHELL=$(getent passwd "$CURRENT_USER" | cut -d: -f7)
  ZSH_BIN=$(command -v zsh)
  if [[ -n "$ZSH_BIN" ]] && [[ "$CURRENT_SHELL" != "$ZSH_BIN" ]]; then
    if ! grep -qxF "$ZSH_BIN" /etc/shells 2>/dev/null; then
      echo "Registrando $ZSH_BIN em /etc/shells..."
      echo "$ZSH_BIN" | sudo tee -a /etc/shells > /dev/null
    fi
    echo "Definindo zsh como shell padrão para $CURRENT_USER..."
    if sudo chsh -s "$ZSH_BIN" "$CURRENT_USER"; then
      echo "Shell padrão alterado. Faça logout/login (ou reboot) para valer."
    else
      echo "AVISO: falha ao trocar shell padrão via chsh." >&2
    fi
    echo ""
  fi
fi

echo ">>> FIM: 03-install-zsh-plugins"
echo ""
